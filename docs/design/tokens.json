{
  "$schema": "design tokens v0 (draft)",
  "meta": {
    "version": "0.1-draft",
    "date": "2026-09-11",
    "status": "初稿：顏色直接從品牌參考 icon 取樣（docs/design/brand/reference_bento_icon.png），由 Claude Design 在 D0 定稿後改為 1.0",
    "style": "可愛手繪風（見 914Apps/BRAND.md）；介面本體乾淨，手繪只在 icon、啟動、引導卡、空狀態"
  },
  "color": {
    "brand": {
      "cream":   { "value": "#FBF5D3", "note": "icon 底色，亮色模式的頁面底" },
      "yolk":    { "value": "#FCD861", "note": "蛋黃：主色候選、反白色" },
      "pink":    { "value": "#FC8DA7", "note": "粉紅：主色候選、便當盒" },
      "tomato":  { "value": "#FD613F", "note": "番茄紅：× 不會、錯誤" },
      "tomatoDeep": { "value": "#B63822", "note": "番茄深色：× 的文字色" },
      "lettuce": { "value": "#69942D", "note": "萵苣綠：○ 會了、成功" },
      "amber":   { "value": "#E0A400", "note": "琥珀：△ 有卡點、警示（由蛋黃加深，非取樣）" },
      "ink":     { "value": "#461607", "note": "描邊深棕：主要文字、線條" },
      "inkSoft": { "value": "#453115", "note": "次要文字" },
      "paper":   { "value": "#FCF9EE", "note": "卡片底" },
      "blush":   { "value": "#FDEFE4", "note": "淡底、hover" }
    },
    "light": {
      "bg":        "{color.brand.cream}",
      "surface":   "{color.brand.paper}",
      "surfaceAlt":"{color.brand.blush}",
      "text":      "{color.brand.ink}",
      "textSoft":  "{color.brand.inkSoft}",
      "line":      "#E8DDC0",
      "primary":   "{color.brand.pink}",
      "primaryText": "#FFFFFF",
      "ok":        "{color.brand.lettuce}",
      "okBg":      "#EEF4DF",
      "mid":       "{color.brand.amber}",
      "midBg":     "#FFF3C4",
      "no":        "{color.brand.tomatoDeep}",
      "noBg":      "#FFE3DA",
      "highlight": "{color.brand.yolk}",
      "highlightSoft": "rgba(252,216,97,0.35)",
      "focus":     "{color.brand.pink}"
    },
    "dark": {
      "bg":        "#1E2418",
      "surface":   "#27301F",
      "surfaceAlt":"#313B27",
      "text":      "#F5EFD9",
      "textSoft":  "#C9C0A3",
      "line":      "#3E4A32",
      "primary":   "{color.brand.pink}",
      "primaryText": "#1E2418",
      "ok":        "#9CC45A",
      "okBg":      "#2F3E22",
      "mid":       "{color.brand.yolk}",
      "midBg":     "#4A3E12",
      "no":        "#FF8A6E",
      "noBg":      "#4A2418",
      "highlight": "#E6B800",
      "highlightSoft": "rgba(230,184,0,0.30)",
      "focus":     "{color.brand.yolk}"
    },
    "note": "亮／深兩組都要過 WCAG AA：text/bg ≥ 7:1、textSoft/bg ≥ 4.5:1、ok/mid/no 文字在各自的 Bg 上 ≥ 4.5:1。Claude Design 定稿時請驗證並回填實測值。"
  },
  "typography": {
    "fontFamily": {
      "ui":    "-apple-system, 'PingFang TC', 'Noto Sans TC', system-ui, sans-serif",
      "serif": "'Iowan Old Style', Georgia, 'Noto Serif TC', serif",
      "mono":  "Menlo, Consolas, monospace"
    },
    "baseSize": { "default": 17, "min": 14, "max": 26, "note": "使用者 A－A＋ 調整整體 rem" },
    "scale": {
      "headword": { "size": "2rem",   "weight": 700, "family": "ui" },
      "title":    { "size": "1.25rem","weight": 700, "family": "ui" },
      "body":     { "size": "1rem",   "weight": 400, "family": "ui", "lineHeight": 1.75 },
      "sentence": { "size": "1.06rem","weight": 400, "family": "serif", "lineHeight": 1.95 },
      "syllable": { "size": "1.05rem","weight": 400, "family": "serif", "letterSpacing": "0.06em" },
      "meta":     { "size": "0.86rem","weight": 400, "family": "ui" },
      "hint":     { "size": "0.78rem","weight": 400, "family": "ui" },
      "mono":     { "size": "0.86rem","weight": 400, "family": "mono" }
    }
  },
  "spacing": { "unit": 4, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "cardPadding": 20, "cardMaxWidth": 640 },
  "radius": { "sm": 3, "md": 6, "lg": 12, "card": 14, "pill": 999, "note": "手繪風的圓潤感靠 lg/card；介面元件仍用 sm/md 保持乾淨" },
  "border": { "width": 1, "color": "{color.light.line}", "strong": 2 },
  "elevation": { "card": "none", "sheet": "0 -2px 12px rgba(0,0,0,0.08)", "note": "不用陰影做層次，用底色與線" },
  "components": {
    "button": { "height": 44, "minTouch": 44, "radius": "{radius.md}", "primaryBg": "{color.light.primary}", "primaryText": "{color.light.primaryText}", "ghostBorder": "{color.light.line}" },
    "markButtons": { "ok": "{color.light.ok}", "mid": "{color.light.mid}", "no": "{color.light.no}", "layout": "三顆並排等寬，永遠這個順序：○ △ ×" },
    "familiarityDots": { "count": 8, "size": "9x5", "on": "{color.light.ok}", "off": "{color.light.line}" },
    "audioBar": { "buttons": ["單字", "整句", "跟讀", "錄音", "播我的"], "height": 36 },
    "coachMark": { "bg": "{color.light.surface}", "border": "{color.light.primary}", "maxWidth": 280, "dismiss": "知道了" },
    "tabBar": { "items": 5, "height": 56, "activeBg": "{color.light.text}", "activeText": "{color.light.bg}" },
    "sideRail": { "width": 72 },
    "sideNav": { "width": 220 },
    "asidePanel": { "width": 300 }
  },
  "layout": {
    "breakpoints": { "phone": "< 600", "tablet": "600–1024", "desktop": "> 1024" },
    "orientation": "不鎖方向；手機橫式練習卡兩欄",
    "foldable": "依視窗寬度與 displayFeatures；封面＝phone、內螢幕＝tablet、半開＝上下分割避鉸鏈",
    "contentMaxWidth": 640
  },
  "illustration": {
    "where": ["appIcon", "splash", "loginHero", "onboardingCards", "emptyStates", "streakDone"],
    "notWhere": ["practiceCard", "articleBody", "tables", "settings", "teacherData"],
    "style": "同 docs/design/brand/reference_bento_icon.png 的筆觸；主題物件：字卡與耳機",
    "signature": { "file": "docs/design/brand/avatar.png", "minSize": 24, "clearSpace": "一個圓的半徑", "where": ["about", "splashCorner", "storeDeveloperImage", "pdfCover", "readmeTop"] }
  }
}
